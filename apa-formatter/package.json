{
  "name": "apa-formatter",
  "version": "0.1.0",
  "private": true,
  "description": "Drop in a school paper, get back an APA 7 formatted DOCX or PDF.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
